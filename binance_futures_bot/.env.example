# ===== 幣安 API（請先用測試網！）=====
# 測試網申請：https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = 測試網（假錢）；false = 正式網（真錢）
USE_TESTNET=true
# true = 紙上交易，只在本機模擬，不送出任何訂單
DRY_RUN=true

# ===== 交易設定 =====
SYMBOL=BTCUSDT
INTERVAL=15m
LEVERAGE=5
# ISOLATED（逐倉）或 CROSSED（全倉）
MARGIN_TYPE=ISOLATED

# ===== 策略參數 =====
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0

# ===== 風控 =====
# 每筆交易最多虧損帳戶餘額的百分比
RISK_PER_TRADE_PCT=1.0
# 單筆倉位名目價值上限 = 餘額 × 槓桿 × 此比例
MAX_POSITION_FRACTION=0.5
# 當日虧損達此百分比後停止開新倉
MAX_DAILY_LOSS_PCT=5.0
# 紙上交易的起始資金
PAPER_BALANCE=1000
